{
    "php.validate.executablePath": "php",
    "php.validate.run": "onSave",
    "[php]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "debug.allowBreakpointsEverywhere": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.log": true
    }
}
